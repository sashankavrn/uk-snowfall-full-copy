{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowReadAccess",
            "Effect": "Allow",
            "Principal": "*",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-landing-${account_number}",
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-landing-${account_number}/*",
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-processed-${account_number}",
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-processed-${account_number}/*"
            ]
        },
        {
            "Sid": "AllowWriteAccess",
            "Effect": "Allow",
            "Principal": "*",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-landing-${account_number}/*",
                "arn:aws:s3:::eu-central1-${environment}-uk-snowfall-datashare-processed-${account_number}/*"
            ]
        }
    ]
}

